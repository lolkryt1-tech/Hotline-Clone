hover_timer += 0.05; 
if (weapon == WEAPONS.BAT)  { image_index = 0; weapon_type = TYPE.MELEE; }
if (weapon == WEAPONS.PIPE) { image_index = 1; weapon_type = TYPE.MELEE; }
if (weapon == WEAPONS.PISTOL)  { image_index = 2; weapon_type = TYPE.RANGE; }
if (weapon == WEAPONS.SHOTGUN)  { image_index = 3; weapon_type = TYPE.RANGE; }
if (weapon == WEAPONS.M16)  { image_index = 4; weapon_type = TYPE.RANGE; }