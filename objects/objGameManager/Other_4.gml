// Событие Room Start внутри твоего объекта-контроллера миссии:

if (room == Room1) // Твоё имя первой комнаты
{
    global.current_level.current_floor = 0; // Смотрим на 1-й этаж в списке
}

if (room == Room2) // Твоё имя второй комнаты
{
    global.current_level.current_floor = 1; // Смотрим на 2-й этаж в списке
}

if (room == Room3) // Твоё имя третьей комнаты
{
    global.current_level.current_floor = 2; // Смотрим на 3-й этаж в списке
}
