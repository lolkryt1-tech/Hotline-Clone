/// @desc Бесшовно переводит фокус ИИ всех врагов со старого ID цели на новый ID цели
/// @param {Id} _old_target_id Кто исчезает (удаляемый инстанс игрока, врага или объекта казни)
/// @param {Id} _new_target_id Кто появляется взамен (новый инстанс игрока, врага или другой казни)
function scrEnemyUpdateTargetID(_old_target_id, _new_target_id)
{
	// Подстраховка: если переключать не на кого, скрипт просто ничего не делает
	if (!instance_exists(_new_target_id)) return;

	// Пробегаемся по абсолютно всем врагам на уровне за один микрокадр
	with (objEnemy)
	{
		// Если этот конкретный враг преследовал именно старый ID
		if (my_target == _old_target_id)
		{
			// Бесшовно пересаживаем его ИИ на новую цель
			my_target = _new_target_id;
			
			// Обновляем координаты последней точки контакта, чтобы ИИ не сбрасывал пути
			last_seen_x = _new_target_id.x;
			last_seen_y = _new_target_id.y;
		}
	}
}
