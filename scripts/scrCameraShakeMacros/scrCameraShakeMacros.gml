function scrCameraShakeMacros()
{

	#macro SHAKE_WEAPONS     "weapons"
	#macro SHAKE_ACTIONS     "actions"
	#macro SHAKE_EXECUTIONS  "executions"

	// === WEAPONS ===
	#macro SHAKE_WEAP_PISTOL      "pistol"
	#macro SHAKE_WEAP_SHOTGUN     "shotgun"
	#macro SHAKE_WEAP_M16         "m16"
	#macro SHAKE_WEAP_SNIPER      "sniper"
	#macro SHAKE_WEAP_UNARMED     "unarmed"
	#macro SHAKE_WEAP_KNIFE       "knife"
	#macro SHAKE_WEAP_BAT         "bat"
	#macro SHAKE_WEAP_PIPE        "pipe"
	#macro SHAKE_WEAP_SLEDGEHAMMER "sledgehammer"

	// === ACTIONS ===
	#macro SHAKE_ACT_KNOCK_DOOR   "knock_door"
	#macro SHAKE_ACT_KNOCK_UNARM  "knock_unarmed"
	#macro SHAKE_ACT_KILL_BLUNT   "kill_blunt"
	#macro SHAKE_ACT_KILL_CUT     "kill_cut"
	#macro SHAKE_ACT_KILL_SLASH   "kill_slash"
	#macro SHAKE_ACT_DIE_BLUNT    "die_blunt"
	#macro SHAKE_ACT_DIE_CUT      "die_cut"
	#macro SHAKE_ACT_DIE_SLASH    "die_slash"
	#macro SHAKE_ACT_DIE_SHOT     "die_shot"
	#macro SHAKE_ACT_ENEMY_SHOOT  "enemy_shoot"
	#macro SHAKE_ACT_TECH_EXPL	  "tech_explosion"

	// === EXECUTIONS ===
	#macro SHAKE_EXEC_UNARMED_STOMP   "unarmed_stomp"
	#macro SHAKE_EXEC_FIREARM_BLUNT   "firearm_blunt"
	#macro SHAKE_EXEC_KNIFE           "knife"
	#macro SHAKE_EXEC_LEAN            "lean"
	#macro SHAKE_EXEC_BLUNT           "blunt"
	#macro SHAKE_EXEC_BLUNT_PIPE      "blunt_pipe"
	#macro SHAKE_EXEC_SLEDGEHAMMER    "sledgehammer"
}