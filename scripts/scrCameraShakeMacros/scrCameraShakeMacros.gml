function scrCameraShakeMacros()
{

	#macro SHAKE_WEAPONS     "weapons"
	#macro SHAKE_ACTIONS     "actions"
	#macro SHAKE_EXECUTIONS  "executions"

	// === WEAPONS ===
	#macro SHAKE_PISTOL      "pistol"
	#macro SHAKE_SHOTGUN     "shotgun"
	#macro SHAKE_M16         "m16"
	#macro SHAKE_SNIPER      "sniper"
	#macro SHAKE_UNARMED     "unarmed"
	#macro SHAKE_KNIFE       "knife"
	#macro SHAKE_BAT         "bat"
	#macro SHAKE_PIPE        "pipe"
	#macro SHAKE_SLEDGEHAMMER "sledgehammer"

	// === ACTIONS ===
	#macro SHAKE_KNOCK_DOOR   "knock_door"
	#macro SHAKE_KNOCK_THROWN "knock_thrown"
	#macro SHAKE_KILL_BLUNT   "kill_blunt"
	#macro SHAKE_KILL_CUT     "kill_cut"
	#macro SHAKE_KILL_SLASH   "kill_slash"
	#macro SHAKE_DIE_BLUNT    "die_blunt"
	#macro SHAKE_DIE_CUT      "die_cut"
	#macro SHAKE_DIE_SLASH    "die_slash"
	#macro SHAKE_DIE_SHOT     "die_shot"
	#macro SHAKE_DIE          "die"

	// === EXECUTIONS ===
	#macro SHAKE_EXEC_UNARMED_STOMP    "unarmed_stomp"
	#macro SHAKE_EXEC_FIREARM_BLUNT   "firearm_blunt"
	#macro SHAKE_EXEC_KNIFE           "knife"
	#macro SHAKE_EXEC_KNIFE_QUICK     "knife_quick"
	#macro SHAKE_EXEC_LEAN            "lean"
	#macro SHAKE_EXEC_BLUNT           "blunt"
	#macro SHAKE_EXEC_BLUNT_PIPE      "blunt_pipe"
	#macro SHAKE_EXEC_SLEDGEHAMMER    "sledgehammer"
}