function scrEnemyRandomStep()
{
    // =========================================================================
    // 1. АВТОМАТ СМЕНЫ ФАЗ (Походил -> Постоял -> Походил)
    // =========================================================================
    random_move_timer--;
    
    if (random_move_timer <= 0)
    {
        // Если до этого СТОЯЛИ (random_dir был равен -1) -> включаем ХОДЬБУ
        if (random_dir == -1)
        {
            random_move_timer = irandom_range(150, 300); 
            random_dir = random(360);                  
        }
        // Если до этого ШЛИ (random_dir хранил угол) -> включаем СТОЯНИЕ
        else 
        {
            random_move_timer = irandom_range(120, 240);  
            random_dir = -1;                            
        }
    }

    // =========================================================================
    // 2. РАСЧЁТ СКОРОСТИ НА ОСНОВЕ ПЕРЕМЕННОЙ НАПРАВЛЕНИЯ
    // =========================================================================
    var _walk_speed = 0;
    
    if (random_dir != -1)
    {
        _walk_speed = max_speed * 0.4; 
    }

    var _vel_x = lengthdir_x(_walk_speed, random_dir);
    var _vel_y = lengthdir_y(_walk_speed, random_dir);

    // =========================================================================
    // 3. ДВИЖЕНИЕ И БЛОК ЗЕРКАЛЬНОГО РЕВЕРСА ОСЕЙ НА C++
    // =========================================================================
    if (random_dir != -1)
    {
        // Запоминаем старые координаты перед шагом
        var _old_x = x;
        var _old_y = y;
        
        // Вызываем встроенное перемещение. Движок сам сдвинет врага.
        var _collisions = move_and_collide(_vel_x, _vel_y, objSolid);
        
        // Если массив не пустой — упёрлись в стену
        if (array_length(_collisions) > 0)
        {
            var _moved_x = x - _old_x;
            var _moved_y = y - _old_y;
            var _any_hit = false;

            // Если не смогли пройти по X столько, сколько планировали — реверсируем X
            if (abs(_moved_x) < abs(_vel_x))
            {
                _vel_x = -_vel_x;
                _any_hit = true;
            }
            
            // Если не смогли пройти по Y столько, сколько планировали — реверсируем Y
            if (abs(_moved_y) < abs(_vel_y))
            {
                _vel_y = -_vel_y;
                _any_hit = true;
            }

            if (_any_hit)
            {
                // Высчитываем новый угол направления на основе отскочивших скоростей
                random_dir = point_direction(0, 0, _vel_x, _vel_y);
                
                // Продлеваем таймер текущего шага, чтобы враг не затупил сразу после отскока
                random_move_timer = max(random_move_timer, 45); 
            }
        }
    }

    // =========================================================================
    // 4. СИНХРОНИЗАЦИЯ НАПРАВЛЕНИЯ И СПРАЙТА
    // =========================================================================
    if (random_dir != -1) 
    {
        direction = random_dir;
    }
    
    target_speed = _walk_speed; 
    speed        = 0; // Глушим встроенный спид GameMaker во избежание багов
}
