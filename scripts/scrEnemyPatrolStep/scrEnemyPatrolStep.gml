function scrEnemyPatrolStep()
{
    // =========================================================================
    // 0. ИНИЦИАЛИЗАЦИЯ: Синхронизируем стартовое направление с редактором комнат
    // =========================================================================
    // Если patrol_dir равен дефолтному нулю, но сам враг развернут иначе —
    // подтягиваем угол из my_angle, который равен image_angle при спавне
    if (patrol_dir == 0 && my_angle != 0)
    {
        patrol_dir = my_angle;
    }

    // =========================================================================
    // 1. ЗАЩИТА: Выравнивание направления строго по осям (0, 90, 180, 270)
    // =========================================================================
    if (patrol_dir % 90 != 0)
    {
        patrol_dir = round(patrol_dir / 90) * 90;
    }
    
    if (patrol_dir >= 360) patrol_dir -= 360;
    if (patrol_dir < 0)   patrol_dir += 360;

    // =========================================================================
    // 2. РАСЧЁТ СКОРОСТИ
    // =========================================================================
    var _walk_speed = max_speed * 0.4; 

    var _vel_x = lengthdir_x(_walk_speed, patrol_dir);
    var _vel_y = lengthdir_y(_walk_speed, patrol_dir);

    // =========================================================================
    // 3. ДВИЖЕНИЕ И ПОВОРОТ НА 90 ГРАДУСОВ ПРИ СТОЛКНОВЕНИИ
    // =========================================================================
    var _collisions = move_and_collide(_vel_x, _vel_y, objSolid);

    if (array_length(_collisions) > 0)
    {
        patrol_dir += 90;
        if (patrol_dir >= 360) patrol_dir -= 360;

        _vel_x = lengthdir_x(_walk_speed, patrol_dir);
        _vel_y = lengthdir_y(_walk_speed, patrol_dir);
    }

    // =========================================================================
    // 4. СИНХРОНИЗАЦИЯ НАПРАВЛЕНИЯ
    // =========================================================================
    direction     = patrol_dir;
    desired_angle = patrol_dir;
    
    target_speed  = _walk_speed; 
    speed         = 0; 
}
